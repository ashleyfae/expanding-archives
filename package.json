{
  "name": "expanding-archives",
  "version": "2.1.1",
  "description": "A widget showing old posts that you can expand by year and month.",
  "scripts": {
    "build": "npm run i18n && npm run build:js && npm run build:css",
    "build:js": "esbuild assets/src/js/expanding-archives.js --bundle --minify --outfile=assets/build/js/expanding-archives.js",
    "build:css": "sass assets/src/sass/expanding-archives.scss assets/build/css/expanding-archives.css --style=compressed --no-source-map",
    "dev": "npm-run-all --parallel dev:js dev:css",
    "dev:js": "esbuild assets/src/js/expanding-archives.js --bundle --outfile=assets/build/js/expanding-archives.js --watch",
    "dev:css": "sass assets/src/sass/expanding-archives.scss assets/build/css/expanding-archives.css --watch",
    "i18n": "wp i18n make-pot . lang/expanding-archives.pot --domain=expanding-archives"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosegraze/expanding-archives.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/nosegraze/expanding-archives/issues"
  },
  "homepage": "https://github.com/nosegraze/expanding-archives#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.103.1"
  }
}
